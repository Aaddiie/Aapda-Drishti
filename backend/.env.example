# =====================================================================
# AAPDA DRISHTI Backend — Environment Configuration Template
# Copy this file to '.env' and populate with your local values.
# NEVER commit the actual '.env' file or production credentials to Git.
# =====================================================================

# Django Core Settings
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-50-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# CORS Settings (Restricted strictly to the React frontend development origin)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Settings (MySQL)
# Rule: Do not use the MySQL 'root' superuser. Use a dedicated application user.
#
# Run the following SQL in MySQL Workbench or MySQL Shell:
#   CREATE DATABASE IF NOT EXISTS aapda_drishti CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER IF NOT EXISTS 'aapda_user'@'localhost' IDENTIFIED BY 'your_secure_password';
#   GRANT ALL PRIVILEGES ON aapda_drishti.* TO 'aapda_user'@'localhost';
#   FLUSH PRIVILEGES;

DB_ENGINE=django.db.backends.mysql
DB_NAME=aapda_drishti
DB_USER=aapda_user
DB_PASSWORD=your_secure_password
DB_HOST=127.0.0.1
DB_PORT=3306
